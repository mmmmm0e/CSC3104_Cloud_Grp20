{
  "name": "cranelock-progress",
  "services": {
    "demo": {
      "image": "cranelock-progress:0.1.0",
      "build": {"context": "..", "dockerfile": "Dockerfile.progress"},
      "init": true,
      "read_only": true,
      "tmpfs": ["/tmp"],
      "cap_drop": ["ALL"],
      "security_opt": ["no-new-privileges:true"],
      "profiles": ["tools"],
      "restart": "no",
      "command": ["-m", "cranelock_sim.progress_demo", "--with-controller"],
      "volumes": ["progress-data:/data"]
    },
    "evaluation": {
      "image": "cranelock-progress:0.1.0",
      "build": {"context": "..", "dockerfile": "Dockerfile.progress"},
      "init": true,
      "read_only": true,
      "tmpfs": ["/tmp"],
      "cap_drop": ["ALL"],
      "security_opt": ["no-new-privileges:true"],
      "profiles": ["tools"],
      "restart": "no",
      "command": ["-m", "cranelock_sim", "--mode", "benefits", "--duration", "5"],
      "volumes": ["progress-data:/data"]
    },
    "dashboard": {
      "image": "cranelock-progress:0.1.0",
      "build": {"context": "..", "dockerfile": "Dockerfile.progress"},
      "init": true,
      "read_only": true,
      "tmpfs": ["/tmp"],
      "cap_drop": ["ALL"],
      "security_opt": ["no-new-privileges:true"],
      "command": ["-m", "cranelock_sim.dashboard", "--root", "/data/run/evaluation", "--bind", "0.0.0.0"],
      "ports": ["127.0.0.1:8765:8765"],
      "volumes": ["progress-data:/data:ro"],
      "restart": "unless-stopped",
      "healthcheck": {
        "test": ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8765/api/catalog', timeout=3).close()"],
        "interval": "10s",
        "timeout": "5s",
        "retries": 3,
        "start_period": "5s"
      }
    }
  },
  "volumes": {"progress-data": {}}
}
