FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml ./
COPY cranelock ./cranelock
COPY cranelock_gate ./cranelock_gate
COPY cranelock_sim ./cranelock_sim
RUN pip install --no-cache-dir . && useradd --uid 10001 --create-home crane
USER 10001:10001
ENTRYPOINT ["python", "-B", "-u", "-m"]
