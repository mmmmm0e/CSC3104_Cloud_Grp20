          "titleSize": 14,
          "valueSize": 40
        },
        "justifyMode": "center",
        "orientation": "vertical",
        "showPercentChange": false,
        "wideLayout": false
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Gate off",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "semi-dark-green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Yes",
                  "color": "semi-dark-green",
