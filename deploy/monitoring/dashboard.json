{
  "id": null,
  "uid": "cranelock-integrated",
  "title": "CraneLock Integrated Platform",
  "description": "Live view: who has the token, who is in charge, and whether cranes may enter the lane.",
  "schemaVersion": 41,
  "version": 3,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "tags": [
    "platform",
    "local-simulation"
  ],
  "panels": [
    {
      "title": "Who has the token?",
      "description": "Only the crane holding the token (a talking stick) may ask to enter the lane.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "cranelock-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cranelock_agent_has_token == 1",
          "instant": true,
          "legendFormat": "{{agent_id}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "name",
        "colorMode": "background_solid",
        "graphMode": "none",
        "text": {
          "titleSize": 14,
          "valueSize": 40
        },
        "justifyMode": "center",
        "orientation": "vertical",
        "showPercentChange": false,
        "wideLayout": false
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Nobody",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "semi-dark-green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "id": 1
    },
    {
      "title": "Who is in charge?",
      "description": "Manager: the controller hands out the token. Cranes: the manager is missing, so the cranes pass the token among themselves.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "cranelock-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(sum by (agent_id) (cranelock_agent_mode{mode=\"CENTRAL\"}) + 2 * sum by (agent_id) (cranelock_agent_mode{mode=\"LOCAL\"}) + 3 * sum by (agent_id) (cranelock_agent_mode{mode=\"REJOINING\"}))",
          "instant": true,
          "legendFormat": "Mode"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "value",
        "colorMode": "background_solid",
        "graphMode": "none",
        "text": {
          "titleSize": 14,
          "valueSize": 40
        },
        "justifyMode": "center",
        "orientation": "vertical",
        "showPercentChange": false,
        "wideLayout": false
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "semi-dark-green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Manager",
                  "color": "semi-dark-blue",
                  "index": 0
                },
                "2": {
                  "text": "Cranes",
                  "color": "semi-dark-orange",
                  "index": 1
                },
                "3": {
                  "text": "Catching up",
                  "color": "semi-dark-purple",
                  "index": 2
                },
                "0": {
                  "text": "Unknown",
                  "color": "semi-dark-red",
                  "index": 3
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "id": 2
    },
    {
      "title": "Can cranes enter the lane?",
      "description": "Even with the token, a crane may only enter when the lane camera confirms the lane is clear. If the camera is unsure (for example after a restart), nobody may enter. That is the safe choice.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "cranelock-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cranelock_gate_lane_unknown",
          "instant": true,
          "legendFormat": "Lane"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "value",
        "colorMode": "background_solid",
