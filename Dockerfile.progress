FROM python:3.12-slim AS build
WORKDIR /build
COPY pyproject.toml ./
COPY cranelock ./cranelock
COPY cranelock_gate ./cranelock_gate
COPY cranelock_sim ./cranelock_sim
RUN pip wheel --no-cache-dir --wheel-dir /wheels ".[evaluation]"

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 MPLCONFIGDIR=/tmp/matplotlib
COPY --from=build /wheels /wheels
RUN pip install --no-cache-dir --no-index --find-links=/wheels "cranelock-gate[evaluation]" \
    && rm -rf /wheels \
    && useradd --uid 10001 --create-home demo \
    && mkdir -p /data/run/evaluation \
    && chown -R demo:demo /data
USER 10001:10001
WORKDIR /data
EXPOSE 8765
ENTRYPOINT ["python", "-u"]
CMD ["-m", "cranelock_sim.progress_demo", "--with-controller"]
